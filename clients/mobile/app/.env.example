# Split ports (debug). Prefer unified edge below for Part 5.
EXPO_PUBLIC_API_IDENTITY_BASE_URL=http://localhost:8080
EXPO_PUBLIC_API_MESSAGE_BASE_URL=http://localhost:8082
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8082
EXPO_PUBLIC_MESSAGE_HTTP_AUTH_MODE=TOKEN
EXPO_PUBLIC_WS_AUTH_MODE=TOKEN_QUERY

# One URL via infra edge (:8088) — copy these when using ./scripts/local-up.sh defaults:
# EXPO_PUBLIC_API_IDENTITY_BASE_URL=http://localhost:8088/api/identity
# EXPO_PUBLIC_API_MESSAGE_BASE_URL=http://localhost:8088/api/messaging
# EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8088/api/messaging
# EXPO_PUBLIC_MESSAGE_HTTP_AUTH_MODE=TOKEN
# EXPO_PUBLIC_WS_AUTH_MODE=TOKEN_QUERY

# On Expo Go phone: replace localhost with LAN IP (ipconfig getifaddr en0).
