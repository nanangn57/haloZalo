# Public hostname and Let's Encrypt contact
DOMAIN=halozalo.nltuanthanh.io.vn
ACME_EMAIL=replace-with-a-real-email@example.com

# Folder paths are relative to infra/docker-compose.yml.
# Default assumes the repository folders are services/identity, services/messaging, and ui.
IDENTITY_CONTEXT=../services/identity
MESSAGING_CONTEXT=../services/messaging

# One PostgreSQL server, two logical databases and two separate database users.
DB_NAME=halozalo
DB_USER=halozalo
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Keep false on a public deployment. True only for isolated local development.
MESSAGING_USER_HEADER_ENABLED=false
