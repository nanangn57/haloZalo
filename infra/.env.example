# Public hostname and Let's Encrypt contact
DOMAIN=halozalo.nltuanthanh.io.vn
ACME_EMAIL=replace-with-a-real-email@example.com

# Build context (relative to infra/)
APP_CONTEXT=../services

# PostgreSQL
# Local Compose: DB_HOST=postgres + deploy/local-up with profile local-db
# Cloud: DB_HOST=<rds-endpoint> (Amazon RDS for PostgreSQL, same VPC as EC2)
DB_HOST=postgres
DB_NAME=halozalo
DB_USER=halozalo
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Keep false on a public deployment.
MESSAGING_USER_HEADER_ENABLED=false

# Registration: email (verification link) | immediate (ops only)
IDENTITY_REGISTRATION_ACTIVATION=email

# Mail: log (local) | smtp (Gmail app password / SMTP — secrets in .env, never commit)
IDENTITY_MAIL_MODE=smtp
IDENTITY_MAIL_FROM=you@gmail.com
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=you@gmail.com
SPRING_MAIL_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD

# Media: local disk or S3 (cloud default s3)
MESSAGING_MEDIA_BACKEND=s3
MESSAGING_MEDIA_S3_BUCKET=halozalo-media-715832090861-ap-southeast-1-an
MESSAGING_MEDIA_S3_REGION=ap-southeast-1
MESSAGING_MEDIA_S3_KEY_PREFIX=media/

# Frontend bake-time URLs (must match connectionConfig VITE_* keys)
VITE_API_IDENTITY_BASE_URL=https://halozalo.nltuanthanh.io.vn/api/identity
VITE_API_MESSAGE_BASE_URL=https://halozalo.nltuanthanh.io.vn/api/messaging
VITE_WS_BASE_URL=wss://halozalo.nltuanthanh.io.vn/api/messaging
