# Copy to infra/.env for local compose (docker-compose.local.yml).
DOMAIN=localhost
ACME_EMAIL=dev@localhost

IDENTITY_CONTEXT=../services
MESSAGING_CONTEXT=../services

DB_NAME=halozalo
DB_USER=halozalo
DB_PASSWORD=halozalo

# Part 5 defaults: Bearer only + one URL on :8088
MESSAGING_USER_HEADER_ENABLED=false
MESSAGING_SESSION_AUTH_ENABLED=true
MESSAGING_MEDIA_PUBLIC_BASE_URL=http://localhost:8088/api/messaging
VITE_API_BASE_URL=http://localhost:8088/api/identity
