# Copy to infra/.env for local compose (docker-compose.local.yml + profile local-db).
DOMAIN=localhost
ACME_EMAIL=dev@localhost

APP_CONTEXT=../services

# Local Compose Postgres service name (required for profile local-db)
DB_HOST=postgres
DB_NAME=halozalo
DB_USER=halozalo
DB_PASSWORD=halozalo

MESSAGING_USER_HEADER_ENABLED=false
MESSAGING_MEDIA_BACKEND=local
MESSAGING_MEDIA_PUBLIC_BASE_URL=http://localhost:8080

# Local: write verification links to app logs (IDENTITY_MAIL_MODE=log)
IDENTITY_MAIL_MODE=log
IDENTITY_MAIL_FROM=noreply@halozalo.local

# Optional: promote these usernames to platform ADMIN on startup
# IDENTITY_PLATFORM_ADMINS=admin

VITE_API_IDENTITY_BASE_URL=http://localhost:8080
VITE_API_MESSAGE_BASE_URL=http://localhost:8080
VITE_WS_BASE_URL=ws://localhost:8080
