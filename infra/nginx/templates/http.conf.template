server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Docker embedded DNS — re-resolve `app` after container recreate.
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 20m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /actuator/health {
        set $app_upstream http://app:8080;
        proxy_pass $app_upstream/actuator/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /api/identity {
        return 301 /api/identity/;
    }

    location ^~ /api/identity/ {
        set $app_upstream http://app:8080;
        rewrite ^/api/identity/(.*)$ /$1 break;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/messaging {
        return 301 /api/messaging/;
    }

    # Variable proxy_pass with a URI drops $args unless appended ($is_args$args).
    # Without access_token the session filter returns 401 and the browser WS stays offline.
    location ^~ /api/messaging/ws {
        set $app_upstream http://app:8080;
        proxy_pass $app_upstream/ws$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /api/messaging/ {
        set $app_upstream http://app:8080;
        rewrite ^/api/messaging/(.*)$ /$1 break;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth {
        return 308 /api/auth/;
    }

    location ^~ /api/auth/ {
        set $app_upstream http://app:8080;
        rewrite ^/api/auth/(.*)$ /auth/$1 break;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
