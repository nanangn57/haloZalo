# HTTP server: keep ACME HTTP-01 reachable and redirect all other requests to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;

    # Docker embedded DNS — re-resolve `app` after container recreate.
    resolver 127.0.0.11 valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;
    # Match Spring multipart (25MB file / 26MB request) so phone video uploads are not reset mid-body.
    client_max_body_size 26m;

    location = /actuator/health {
        set $app_upstream http://app:8080;
        proxy_pass $app_upstream/actuator/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location = /api/identity {
        return 301 /api/identity/;
    }

    location ^~ /api/identity/ {
        set $app_upstream http://app:8080;
        rewrite ^/api/identity/(.*)$ /$1 break;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/messaging {
        return 301 /api/messaging/;
    }

    # Variable proxy_pass with a URI drops $args unless appended ($is_args$args).
    # Without access_token the session filter returns 401 and the browser WS stays Offline.
    location ^~ /api/messaging/ws {
        set $app_upstream http://app:8080;
        proxy_pass $app_upstream/ws$is_args$args;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /api/messaging/ {
        set $app_upstream http://app:8080;
        rewrite ^/api/messaging/(.*)$ /$1 break;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/auth {
        return 308 /api/auth/;
    }

    location ^~ /api/auth/ {
        set $app_upstream http://app:8080;
        rewrite ^/api/auth/(.*)$ /auth/$1 break;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React Router history fallback for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
