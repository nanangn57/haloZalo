# Copy to .env.local in this folder. Never commit .env.local.
# Plain KEY=value: no quotes, no spaces around =.

# Mail: log (default local) | smtp (Gmail/SMTP)
IDENTITY_MAIL_MODE=log
IDENTITY_MAIL_FROM=noreply@halozalo.local

# When IDENTITY_MAIL_MODE=smtp:
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=you@gmail.com
# SPRING_MAIL_PASSWORD=your-gmail-app-password

IDENTITY_PUBLIC_BASE_URL=http://localhost:8080
IDENTITY_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
# Comma-separated usernames that receive platformRole=ADMIN
IDENTITY_PLATFORM_ADMINS=
