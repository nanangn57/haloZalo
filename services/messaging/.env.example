# Copy to .env.local in this folder and fill in your values. .env.local is git-ignored; never commit it.
# Plain KEY=value lines: no quotes, no spaces around =. A backslash in a value must be written as \\.
# Environment variables set in the shell or on the server win over this file.

# The shared PostgreSQL database halozalo. Messaging uses only schema messaging, created by Flyway on start.
# The defaults match infra/docker-compose.yml and ./local-deps.sh.
# Cloud example: jdbc:postgresql://<host>:5432/halozalo?sslmode=require
POSTGRES_URL=jdbc:postgresql://localhost:5432/halozalo
POSTGRES_USER=halozalo
POSTGRES_PASSWORD=halozalo

# true while messaging runs on its own: the X-User-Id header says who is calling.
# Must be false in the app, where the session filter sets the user. See http.CurrentUser.
MESSAGING_USER_HEADER_ENABLED=true
