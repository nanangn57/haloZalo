# Copy to .env.local in this folder and fill in your values. .env.local is git-ignored; never commit it.
# Plain KEY=value lines: no quotes, no spaces around =. A backslash in a value must be written as \\.
# Environment variables set in the shell or on the server win over this file.

# PostgreSQL. The defaults match ./local-deps.sh and docker-compose.yml.
# Cloud example: jdbc:postgresql://<host>:5432/messaging?sslmode=require
POSTGRES_URL=jdbc:postgresql://localhost:5432/messaging
POSTGRES_USER=messaging
POSTGRES_PASSWORD=messaging

# Redis for realtime fan-out between instances.
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty when Redis has no auth. REDIS_USERNAME is only for Redis ACL users.
REDIS_USERNAME=
REDIS_PASSWORD=
# true for TLS, for example AWS ElastiCache with in-transit encryption.
REDIS_SSL_ENABLED=false

# redis: fan-out across all instances. local: one instance only, no Redis needed.
MESSAGING_REALTIME_BUS=redis
